{
  // Compiles the agent to plain JavaScript in agent/dist, so the web's API routes
  // can load it as an external Node package (`npm run build -w agent`).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["*.ts", "reader/**/*.ts", "collector/**/*.ts", "usage/**/*.ts"],
  "exclude": ["tests", "eval", "dist", "node_modules"]
}
