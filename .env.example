# Salin file ini menjadi .env:  cp .env.example .env
# JANGAN pernah commit .env. Kunci privat hanya boleh ditulis di .env (dan env Vercel).

# ===================================================================
# Jaringan NEAR
# ===================================================================

# Jaringan NEAR. Hanya testnet (PLAN.md KTD1). Jangan diganti ke mainnet.
NEAR_NETWORK=testnet

# RPC endpoint. Opsional — default testnet FastNEAR. Bisa diganti kalau perlu.
NEAR_RPC_URL=

# ===================================================================
# Akun master & kontrak (diisi Orang 1 setelah setup:demo / deploy)
# ===================================================================

# Akun master tim, contoh: fullback-team.testnet
MASTER_ACCOUNT_ID=

# Kunci akun master — dipakai setup:demo untuk membuat subakun. RAHASIA.
MASTER_PRIVATE_KEY=

# Kontrak FULLBACK dan token fEUR yang sudah dideploy tim (diisi Orang 1 setelah U3)
CONTRACT_ID=
FT_ID=

# ===================================================================
# Agen Penagih (Collector): kunci terbatas yang hanya boleh memanggil settle_due (R13)
# ===================================================================

KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=

# ===================================================================
# Akun demo untuk Judge demo mode (R18) — ditandatangani server, bukan browser.
# Catatan: npm run setup:demo MENULIS otomatis pasangan akun+kunci ini ke
# scripts/.env.demo. Baris di bawah adalah daftar variabel yang dibutuhkan
# run-demo.ts / web; jangan mengisinya manual kecuali tahu caranya.
# ===================================================================

FT_OWNER_ACCOUNT_ID=
FT_OWNER_PRIVATE_KEY=
DEMO_SELLER_ACCOUNT_ID=
DEMO_SELLER_PRIVATE_KEY=
DEMO_BUYER_ACCOUNT_ID=
DEMO_BUYER_PRIVATE_KEY=
DEMO_RESALE_BUYER_ACCOUNT_ID=
DEMO_RESALE_BUYER_PRIVATE_KEY=
DEMO_ACADEMY_1_ACCOUNT_ID=
DEMO_ACADEMY_1_PRIVATE_KEY=
DEMO_ACADEMY_2_ACCOUNT_ID=
DEMO_ACADEMY_2_PRIVATE_KEY=

# ===================================================================
# Agen Pembaca (LLM) — API OpenAI-compatible, bisa dipindah provider.
# Detail cara ganti provider/model: agent/README.md (bagian "Ganti model & provider")
# ===================================================================

# Provider umum (baru). Bila kosong, fallback ke NEARAI_* di bawah.
# Contoh NVIDIA NIM: https://integrate.api.nvidia.com/v1  (key: nvapi-...)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# NEAR AI Cloud (default). Kosongkan NEARAI_API_KEY kalau DEMO_MODE=true.
NEARAI_API_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
NEARAI_MODEL=

# true = Pembaca memakai fixture JSON, tidak butuh API key (KTD6, KTD9)
DEMO_MODE=true

# ===================================================================
# Pengujian
# ===================================================================

# LIVE_TEST=1 menjalankan tests/reader-live.test.ts yang memanggil LLM asli.
# Kosongkan untuk tes normal (live test otomatis dilewati).
LIVE_TEST=
