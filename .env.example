# Salin file ini menjadi .env:  cp .env.example .env
# JANGAN pernah commit .env. Kunci privat hanya boleh ditulis di .env (dan env Vercel).

# Jaringan NEAR. Hanya testnet (PLAN.md KTD1). Jangan diganti ke mainnet.
NEAR_NETWORK=testnet

# Akun master tim, contoh: fullback-demo.testnet
MASTER_ACCOUNT_ID=

# Kontrak FULLBACK dan token fEUR yang sudah dideploy tim (diisi Orang 1 setelah U3)
CONTRACT_ID=
FT_ID=

# Agen Penagih: kunci terbatas yang hanya boleh memanggil settle_due (R13)
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=

# Akun demo untuk Judge demo mode (R18). Server yang menandatangani, bukan browser.
DEMO_BUYER_ACCOUNT_ID=
DEMO_BUYER_PRIVATE_KEY=
DEMO_SELLER_ACCOUNT_ID=
DEMO_SELLER_PRIVATE_KEY=
DEMO_RESALE_BUYER_ACCOUNT_ID=
DEMO_RESALE_BUYER_PRIVATE_KEY=
FT_OWNER_ACCOUNT_ID=
FT_OWNER_PRIVATE_KEY=

# Agen Pembaca (NEAR AI Cloud). Kosongkan kalau DEMO_MODE=true.
NEARAI_API_KEY=

# true = Pembaca memakai fixture JSON, tidak butuh API key (KTD6, KTD9)
DEMO_MODE=true
